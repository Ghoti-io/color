# libtiff as the colour library's SGI LogLuv oracle.
#
# libtiff's SGILog codec is the reference implementation of LogL16, LogLuv24
# and LogLuv32 (Larson's own code, contributed to libtiff), so it is what
# "decodes correctly" means for those encodings. Nothing here reads or ports
# its source: logluv_vectors.c only asks it questions - write these codes,
# read them back as float; write these floats, read them back as codes - and
# tools/oracle/gen_logluv.py turns the answers into the committed vectors and
# the 24-bit u'v' cell table.
#
# Same base digest and SNAPSHOT as the Argyll and littleCMS images.
FROM docker.io/library/debian@sha256:7792b1f7702a86946cd518db72b6a407302c3e9bc1635634368b878189e8221c

ARG SNAPSHOT=20260918T000000Z

RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
      "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' \
      > /etc/apt/apt.conf.d/99snapshot

COPY logluv_vectors.c /tmp/logluv_vectors.c
COPY libtiff-version /usr/local/bin/libtiff-version

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
      libtiff6=4.7.0-3+deb13u3 \
      libtiff-dev=4.7.0-3+deb13u3 \
      gcc \
      libc6-dev \
      pkg-config \
    && gcc -O2 -Wall -Wextra -o /usr/local/bin/logluv_vectors \
      /tmp/logluv_vectors.c \
      $(pkg-config --cflags --libs libtiff-4) -lm \
    && chmod 0755 /usr/local/bin/libtiff-version /usr/local/bin/logluv_vectors \
    && rm -f /tmp/logluv_vectors.c \
    && apt-get purge -y --auto-remove gcc libc6-dev pkg-config libtiff-dev \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

ENTRYPOINT []
CMD ["libtiff-version"]
