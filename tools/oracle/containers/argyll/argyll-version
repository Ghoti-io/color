#!/bin/sh
# SPDX-License-Identifier: LGPL-3.0-only
# Print the pin string tools/oracle/containers/IMAGES expects.
# xicclu's banner names the ArgyllCMS release; icclu is the lookup tool the
# gate uses (it accepts the CMYK v2 fixtures xicclu 3.3 rejects).
set -eu
xicclu 2>&1 | head -n 1
icclu 2>&1 | head -n 1
