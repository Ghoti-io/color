# littleCMS 2 as the colour library's ICC v4 (and second CMM) oracle.
#
# Built here: two builds of one Containerfile are not two copies of one image,
# so everything the build reads is pinned (base by digest, packages by full
# apt version against a dated Debian snapshot) and the run-time version check
# in oracle_env.py is the real guarantee.
#
# The lookup tool is compiled into the image: transicc's CLI speaks 8-bit and
# percent scales, which is the wrong interface for comparing float device→XYZ
# against this library. lcms_icc_lookup.c links liblcms2 and prints XYZ the
# same way gcol_icc_lookup does.
#
# The same base digest and SNAPSHOT as the Argyll oracle image.
FROM docker.io/library/debian@sha256:7792b1f7702a86946cd518db72b6a407302c3e9bc1635634368b878189e8221c

ARG SNAPSHOT=20260918T000000Z

RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
      "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' \
      > /etc/apt/apt.conf.d/99snapshot

COPY lcms_icc_lookup.c /tmp/lcms_icc_lookup.c
COPY lcms2-version /usr/local/bin/lcms2-version

# Runtime library + build toolchain, pinned. The finished image keeps only
# liblcms2-2 and the two scripts/binaries the gate needs.
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
      liblcms2-2=2.16-2+deb13u2 \
      liblcms2-dev=2.16-2+deb13u2 \
      gcc \
      libc6-dev \
      pkg-config \
    && gcc -O2 -Wall -Wextra -o /usr/local/bin/lcms_icc_lookup \
      /tmp/lcms_icc_lookup.c \
      $(pkg-config --cflags --libs lcms2) -lm \
    && chmod 0755 /usr/local/bin/lcms2-version /usr/local/bin/lcms_icc_lookup \
    && rm -f /tmp/lcms_icc_lookup.c \
    && apt-get purge -y --auto-remove gcc libc6-dev pkg-config liblcms2-dev \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

ENTRYPOINT []
CMD ["lcms2-version"]
